    <run id="mcmc" spec="MCMC" chainLength="5000000">
        <state id="state" spec="State" storeEvery="5000">
            <tree id="Tree.t:alignment" spec="beast.base.evolution.tree.Tree" name="stateNode">
                <taxonset id="TaxonSet.alignment" spec="TaxonSet">
                    <alignment idref="alignment"/>
                </taxonset>
            </tree>
            <stateNode id="kappa.s:alignment" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="2.0"/>
            <stateNode id="popSize.t:alignment" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="0.3"/>
        </state>
        <init id="RandomTree.t:alignment" spec="RandomTree" estimate="false" initial="@Tree.t:alignment" taxa="@alignment">
            <populationModel id="ConstantPopulation0.t:alignment" spec="ConstantPopulation">
                <parameter id="randomPopSize.t:alignment" spec="parameter.RealParameter" name="popSize">1.0</parameter>
            </populationModel>
        </init>
        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="CoalescentConstant.t:alignment" spec="Coalescent">
                    <populationModel id="ConstantPopulation.t:alignment" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation" popSize="@popSize.t:alignment"/>
                    <treeIntervals id="TreeIntervals.t:alignment" spec="beast.base.evolution.tree.TreeIntervals" tree="@Tree.t:alignment"/>
                </distribution>
                <distribution id="KappaPrior.s:alignment" spec="beast.base.spec.inference.distribution.LogNormal" param="@kappa.s:alignment">
                    <M id="RealScalarParam.10" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" estimate="false" value="1.0"/>
                    <S id="RealScalarParam.11" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.25"/>
                </distribution>
                <distribution id="PopSizePrior.t:alignment" spec="beast.base.spec.inference.distribution.Gamma" param="@popSize.t:alignment">
                    <alpha id="RealScalarParam.39" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" estimate="false" value="0.01"/>
                    <theta id="RealScalarParam.40" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="100.0"/>
                </distribution>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">
                <distribution id="treeLikelihood.alignment" spec="beast.base.spec.evolution.likelihood.ThreadedTreeLikelihood" data="@alignment" tree="@Tree.t:alignment">
                    <siteModel id="SiteModel.s:alignment" spec="beast.base.spec.evolution.sitemodel.SiteModel">
                        <mutationRate id="mutationRate.s:alignment" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                        <shape id="gammaShape.s:alignment" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                        <proportionInvariant id="proportionInvariant.s:alignment" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval" estimate="false"/>
                        <substModel id="hky.s:alignment" spec="beast.base.spec.evolution.substitutionmodel.HKY" kappa="@kappa.s:alignment">
                            <frequencies id="empiricalFreqs.s:alignment" spec="beast.base.spec.evolution.substitutionmodel.Frequencies" data="@alignment"/>
                        </substModel>
                    </siteModel>
                    <branchRateModel id="StrictClock.c:alignment" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel">
                        <clock.rate id="clockRate.c:alignment" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                    </branchRateModel>
                </distribution>
            </distribution>
        </distribution>
        <operator id="KappaScaler.s:alignment" spec="beast.base.spec.evolution.operator.AdaptableOperatorSampler" weight="0.05">
            <parameter idref="kappa.s:alignment"/>
            <operator id="AVMNOperator.alignment" spec="beast.base.spec.evolution.operator.AdaptableVarianceMultivariateNormalOperator" allowNonsense="true" beta="0.05" burnin="400" initial="800" weight="0.1">
                <transformations id="AVMNSumTransform.alignment" spec="beast.base.spec.inference.operator.Transform$LogConstrainedSumTransform"/>
                <transformations id="AVMNLogTransform.alignment" spec="beast.base.spec.inference.operator.Transform$LogTransform">
                    <f idref="kappa.s:alignment"/>
                </transformations>
                <transformations id="AVMNNoTransform.alignment" spec="beast.base.spec.inference.operator.Transform$NoTransform"/>
            </operator>
            <operator id="KappaScalerX.s:alignment" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@kappa.s:alignment" scaleFactor="0.1" upper="10.0" weight="0.1"/>
        </operator>
        <operator id="CoalescentConstantTreeScaler.t:alignment" spec="beast.base.spec.evolution.operator.UpDownOperator" scaleFactor="0.1" weight="4.0">
            <up idref="Tree.t:alignment"/>
        </operator>
        <operator id="CoalescentConstantTreeRootScaler.t:alignment" spec="kernel.BactrianScaleOperator" rootOnly="true" scaleFactor="0.1" tree="@Tree.t:alignment" upper="10.0" weight="3.0"/>
        <operator id="CoalescentConstantUniformOperator.t:alignment" spec="kernel.BactrianNodeOperator" tree="@Tree.t:alignment" weight="30.0"/>
        <operator id="CoalescentConstantSubtreeSlide.t:alignment" spec="kernel.BactrianSubtreeSlide" tree="@Tree.t:alignment" weight="15.0"/>
        <operator id="CoalescentConstantNarrow.t:alignment" spec="Exchange" tree="@Tree.t:alignment" weight="15.0"/>
        <operator id="CoalescentConstantWide.t:alignment" spec="Exchange" isNarrow="false" tree="@Tree.t:alignment" weight="3.0"/>
        <operator id="CoalescentConstantWilsonBalding.t:alignment" spec="WilsonBalding" tree="@Tree.t:alignment" weight="3.0"/>
        <operator id="PopSizeScaler.t:alignment" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@popSize.t:alignment" upper="10.0" weight="3.0"/>
        <logger id="tracelog" spec="Logger" fileName="$(filebase).log" logEvery="10000" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="treeLikelihood.alignment"/>
            <log id="TreeHeight.t:alignment" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:alignment"/>
            <log idref="kappa.s:alignment"/>
            <log idref="popSize.t:alignment"/>
            <log idref="CoalescentConstant.t:alignment"/>
        </logger>
        <logger id="screenlog" spec="Logger" logEvery="100000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
        </logger>
        <logger id="treelog.t:alignment" spec="Logger" fileName="$(filebase)-$(tree).trees" logEvery="10000" mode="tree">
            <log id="TreeWithMetaDataLogger.t:alignment" spec="beast.base.spec.evolution.TreeWithMetaDataLogger" tree="@Tree.t:alignment"/>
        </logger>
        <operatorschedule id="OperatorSchedule" spec="OperatorSchedule"/>
    </run>

